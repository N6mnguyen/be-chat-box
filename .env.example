PORT=3000
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:4200
GOOGLE_CLIENT_ID=774582659488-67b88dnq9amvq4aer3revh814ogh1a2e.apps.googleusercontent.com
# Supabase Transaction Pooler URL. Keep the real password in be-chat-box/.env only.
# Example shape: postgresql://vchat_app.<project-ref>:<DB_PASSWORD>@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Supabase direct/session-pooler URL using the postgres role; used only for one-time schema initialization.
DIRECT_URL=
# Generate a separate strong password and use the same value in DATABASE_URL and here.
VCHAT_APP_PASSWORD=
# Use a stable random secret (at least 32 bytes) to keep refresh tokens valid across BE restarts.
JWT_SECRET=
# Without DATABASE_URL, local development uses temporary embedded PostgreSQL, not Supabase.
