{
  "name": "vchat-be-design",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts --dev",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test:api": "node --env-file-if-exists=.env --import tsx --test src/*.test.ts",
    "test:db": "node --test \"db/test/*.test.js\"",
    "db:supabase:init": "node --env-file-if-exists=.env db/supabase-setup.mjs",
    "db:supabase:count-users": "node --env-file-if-exists=.env db/supabase-count-users.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^17.9.0-beta.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
